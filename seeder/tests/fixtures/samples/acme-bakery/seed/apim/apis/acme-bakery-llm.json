                  "periodTimeUnit": "MINUTES",
                  "resetStrategy": "ROLLING",
                  "key": "{#context.attributes['application']}"
                }
              },
              "description": "3,000 tokens per minute for each application"
            }
          ],
          "response": [],
          "subscribe": [],

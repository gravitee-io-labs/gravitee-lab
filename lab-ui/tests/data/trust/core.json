        "gravitee_services_core_http_authentication_users_admin": "adminadmin",
        "gravitee_services_core_http_host": "localhost"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 20,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "curl -sf -u admin:adminadmin http://localhost:18072/_node/health | grep -Eq '\"healthy\" *: *true'"
        ],
        "timeout": "3s"
      },
      "image": "graviteeio/ae-engine:3.0.2",
      "labels": {
        "io.gravitee.description": "Evaluates alert rules and triggers notifications; needs an Enterprise license",

    "apim-gateway": {
      "command": null,
      "container_name": "gio-apim-gateway",
      "depends_on": {
        "apim-management-api": {
          "condition": "service_healthy",
          "required": true
        },
        "elasticsearch": {
          "condition": "service_healthy",
          "required": true

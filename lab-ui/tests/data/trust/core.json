      ]
    },
    "redis": {
      "command": [
        "redis-server",
        "--requirepass",
        "redispassword"
      ],
      "container_name": "gio-redis",
      "entrypoint": null,
      "healthcheck": {
        "interval": "5s",
        "retries": 20,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "redis-cli -a redispassword --no-auth-warning ping | grep -q PONG"
        ],
        "timeout": "3s"
      },
      "image": "redis:8.10.1-alpine",
      "labels": {
        "io.gravitee.description": "Stores gateway rate limit counters",
        "io.gravitee.group": "Databases",
        "io.gravitee.name": "Redis"
      },
      "networks": {
        "internal": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6379",
          "target": 6379
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "source": "data-redis",
          "target": "/data",
          "type": "volume",
          "volume": {}
        }
      ]
    }

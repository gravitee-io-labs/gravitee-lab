# Copied to .env by `make init`

# Enterprise license (base64)
GRAVITEE_LICENSE=

# Password of user admin on the internal APIs and on the link to the Alert Engine
INTERNAL_API_PASSWORD=adminadmin

# Redis password
REDIS_PASSWORD=redispassword

# The files Compose reads: the core, and what is on. Keep it: without it, docker compose runs the core alone
COMPOSE_FILE=docker-compose.yml:.lab/on.yml

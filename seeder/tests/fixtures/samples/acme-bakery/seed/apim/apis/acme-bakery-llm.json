      ]
    },
    {
      "definitionVersion": "V4",
      "id": "00000000-0000-4000-8000-acb1000a0003",
      "name": "Traffic",
      "description": "The traffic generator: 3,000 tokens a minute, generic answers cached",
      "mode": "STANDARD",
      "status": "PUBLISHED",
      "validation": "AUTO",
      "order": 3,
      "tags": [],
      "characteristics": [],
      "excludedGroups": [],
      "commentRequired": false,
      "security": {
        "type": "API_KEY",
        "configuration": {
          "source": "BEARER",
          "enableCustomApiKeyHeader": false,

{
  "config": {
    "name": "gravitee",
    "networks": {
      "own": {
        "ipam": {},
        "name": "gravitee_own"
      }
    },
    "services": {
      "hostile-clean": {
        "build": {
          "context": "@ROOT@/.lab/catalogs/hostile/addons/p-clean-addon",
          "dockerfile": "Dockerfile"
        },
        "command": null,
        "entrypoint": null,
        "environment": {
          "HOSTILE_GREETING": "hello",
          "INTERNAL_API_PASSWORD": "adminadmin",
          "VERSION_TAG": "1"
        },
        "healthcheck": {
          "test": [
            "CMD",
            "true"
          ]
        },
        "image": "busybox:1.36",
        "labels": {
          "io.gravitee.console.hostile-clean.name": "Clean",
          "io.gravitee.console.hostile-clean.url": "http://localhost:8397",
          "io.gravitee.name": "Clean"
        },
        "networks": {
          "internal": null,
          "own": null
        },
        "ports": [
          {
            "host_ip": "127.0.0.1",
            "mode": "ingress",
            "protocol": "tcp",
            "published": "8397",
            "target": 80
          }
        ],
        "pull_policy": "build",
        "restart": "unless-stopped",
        "volumes": [
          {
            "bind": {},
            "read_only": true,
            "source": "@ROOT@/.lab/catalogs/hostile/addons/p-clean-addon/config.yml",
            "target": "/etc/clean.yml",
            "type": "bind"
          },
          {
            "bind": {},
            "source": "@ROOT@/.lab/catalogs/hostile/addons/p-clean-addon/.state",
            "target": "/state",
            "type": "bind"
          },
          {
            "bind": {},
            "source": "@ROOT@/.lab/catalogs/hostile/addons/p-clean-addon/secrets",
            "target": "/run/secrets",
            "type": "bind"
          },
          {
            "source": "clean-data",
            "target": "/data",
            "type": "volume",
            "volume": {}
          }
        ]
      }
    },
    "volumes": {
      "clean-data": {
        "name": "gravitee_clean-data"
      }
    }
  },
  "error": null,
  "files": {
    "compose.yml": "x-gravitee: {kind: addon, name: Clean add-on, category: Other, description: Every construct a catalog may use}\n\nservices:\n  hostile-clean:\n    image: busybox:1.36\n    build: .\n    pull_policy: build\n    restart: unless-stopped\n    ports:\n      - \"127.0.0.1:8397:80\"\n    environment:\n      HOSTILE_GREETING: ${HOSTILE_GREETING:-hello}\n      INTERNAL_API_PASSWORD: ${INTERNAL_API_PASSWORD:-adminadmin}\n      VERSION_TAG: ${HOSTILE_CLEAN_VERSION:-1}\n    volumes:\n      - ./config.yml:/etc/clean.yml:ro\n      - ./.state:/state\n      - ./secrets:/run/secrets\n      - clean-data:/data\n    networks: [internal, own]\n    labels:\n      io.gravitee.name: Clean\n      io.gravitee.console.hostile-clean.name: Clean\n      io.gravitee.console.hostile-clean.url: http://localhost:8397\n    healthcheck:\n      test: [\"CMD\", \"true\"]\nvolumes:\n  clean-data: {}\nnetworks:\n  own: {}\n"
  },
  "overlaid": {},
  "own": [
    "hostile-clean"
  ],
  "unit": {
    "id": "@hostile/p-clean-addon",
    "includes": [],
    "kind": "addon",
    "meta": {
      "category": "Other",
      "description": "Every construct a catalog may use",
      "kind": "addon",
      "name": "Clean add-on"
    },
    "name": "Clean add-on",
    "references": [
      "HOSTILE_CLEAN_VERSION",
      "HOSTILE_GREETING",
      "INTERNAL_API_PASSWORD"
    ],
    "seed": null,
    "seed_references": []
  }
}

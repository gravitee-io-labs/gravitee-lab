    "apim-management-ui": {
      "command": [
        "/bin/sh",
        "-c",
        "sed -i -e '/X-Frame-Options/d' -e \"/localhost:9000/!s|frame-ancestors 'self'|& http://localhost:9000 http://127.0.0.1:9000|\" /etc/nginx/conf.d/*.conf; for f in $$(grep -L gravitee-lab.js /etc/nginx/conf.d/*.conf); do sed -i -e \"/location \\/ {/i location = /gravitee-lab.js { alias /gravitee-lab.js; }\" -e \"/location \\/ {/a sub_filter </head> '<script src=/gravitee-lab.js></script></head>';\" \"$$f\"; done; sh /check_ip_config.sh; sh /run.sh"
      ],
      "container_name": "gio-apim-management-ui",
      "depends_on": {
        "apim-management-api": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "MGMT_API_URL": "http://localhost:8083/management/organizations/DEFAULT/environments/DEFAULT/"
